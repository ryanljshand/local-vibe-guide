# Local Vibe Guide — environment configuration.
# Copy to `.env` and fill in what you have. EVERYTHING is optional: with no keys
# the app runs in mock mode (realistic sample events + deterministic copy).

# ── LLM (the curator/writer). Auto-selects: Anthropic → OpenAI → mock. ──
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic        # force a provider: anthropic | openai | mock

# ── Event sources (the hero data). Without these, the mock source is used. ──
# Free key: https://developer.ticketmaster.com
# TICKETMASTER_API_KEY=...

# ── Venue pairing (the "drinks before/after" sidekick). ──
# PLACES_PROVIDER=osm           # osm (keyless, default) | mock | off

# ── Server ──
# PORT=3001
